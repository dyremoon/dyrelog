{
  "name": "dyrelog-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Dyrelog's always-on-top desktop overlay (Electron) — the mini-mode DPS meter from the README art spec.",
  "main": "main.js",
  "scripts": {
    "sync-eqp-core": "node scripts/sync-eqp-core.js",
    "start": "npm run sync-eqp-core && electron .",
    "dist": "npm run sync-eqp-core && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.dyrelog.desktop",
    "productName": "Dyrelog",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dyremoon",
        "repo": "dyrelog"
      }
    ]
  }
}
